# OS / editor junk
.DS_Store
*.swp

# transient logs & node deps (docs system is script-driven, no build output tracked)
*.log
node_modules/

# never commit secrets if any script config lands here
.env
.env.*

# Lark bot per-project local secret configs (webhookUrl/secret/appToken/chat_id) — machine-local only
**/agent/scripts/*.json

# Lark bot runtime state — queued group tasks & downloaded group attachments may hold group content
**/agent/lark-tasks/
**/agent/lark-attachments/
**/agent/lark-audits/
**/agent/lark-bugtable-state.json

# installation-specific consumer binding (each checkout/company sets its own;
# the committed docs-tdd.config.default.json holds the reusable defaults)
docs-tdd.config.json

# Local per-machine agent settings (personal permission allowlist, absolute paths)
.claude/
