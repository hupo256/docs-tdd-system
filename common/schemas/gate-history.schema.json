{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate-history.schema.json",
  "title": "docs_tdd Gate History",
  "type": "object",
  "required": ["projectId", "runs"],
  "properties": {
    "projectId": { "type": "string", "pattern": "^PR-\\d{5}$" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "ok", "generatedAt", "tool", "summary", "fingerprint", "evidence"],
        "properties": {
          "gate": { "type": "string", "pattern": "^G[0-8]$" },
          "ok": { "const": true },
          "generatedAt": { "type": "string", "minLength": 1 },
          "tool": { "const": "run-project-gate.mjs" },
          "summary": {
            "type": "object",
            "required": ["total", "ok", "warn", "waived", "fail"],
            "properties": {
              "total": { "type": "integer", "minimum": 0 },
              "ok": { "type": "integer", "minimum": 0 },
              "warn": { "type": "integer", "minimum": 0 },
              "waived": { "type": "integer", "minimum": 0 },
              "fail": { "const": 0 }
            },
            "additionalProperties": false
          },
          "fingerprint": { "type": "object" },
          "evidence": { "type": "string", "pattern": "^evidence/gate/.+/README\\.md$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
