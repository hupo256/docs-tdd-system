{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lark AI task result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "checks", "changedFiles"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["done", "blocked", "failed", "waiting_confirmation"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "status=blocked/waiting_confirmation 时逐条列出缺什么 / 卡在哪个环节 / 需要谁补"
    },
    "owner": {
      "type": "string",
      "description": "可推断到的责任人或角色（如 产品 / QA / 设计），用于回群 @ 提示"
    }
  }
}
