{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lark AI task result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "checks", "changedFiles"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["done", "blocked", "failed", "waiting_confirmation"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "status=blocked/waiting_confirmation 时逐条列出缺什么 / 卡在哪个环节 / 需要谁补"
    },
    "owner": {
      "type": "string",
      "description": "可推断到的责任人或角色（如 产品 / QA / 设计），用于回群 @ 提示"
    },
    "failureKind": {
      "type": "string",
      "enum": ["tool", "env", "permission", "requirement"],
      "description": "status=failed 时的失败归因：tool 工具失败 / env 环境失败 / permission 权限失败 / requirement 需求不清"
    },
    "nextStep": {
      "type": "string",
      "description": "status=failed/blocked/waiting_confirmation 时给人的下一步建议（一句话，人能照做）"
    }
  }
}
