{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lark AI task result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "checks", "changedFiles"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["done", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
