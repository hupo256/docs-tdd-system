{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vnext-dev-check.schema.json",
  "title": "docs_tdd vNext Development Check",
  "type": "object",
  "required": ["schemaVersion", "projectId", "runId", "checkedAt", "status", "ok", "codeState", "changedPaths", "pendingCommitPaths", "pathCoverage", "unmappedPaths", "pathPolicy", "commandSelection", "commandResults", "blockers", "problems"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "pattern": "^(?:PR|TR)-\\d{5}$" },
    "runId": { "type": "string", "minLength": 1 },
    "checkedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "failed", "blocked"] },
    "ok": { "type": "boolean" },
    "codeState": {
      "type": "object",
      "required": ["headSha", "contentHash", "dirtyHash"],
      "properties": {
        "headSha": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 },
        "dirtyHash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "changedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "pendingCommitPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "pathCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "requirementIds", "surfaceIds", "mappingSource"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^R-\\d{3}$" } },
          "surfaceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^S-\\d{3}$" } },
          "mappingSource": { "enum": ["locator", "input", "locator+input"] }
        },
        "additionalProperties": false
      }
    },
    "unmappedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "pathPolicy": {
      "type": "object",
      "required": ["status", "policyPaths", "outOfScopePaths"],
      "properties": {
        "status": { "enum": ["enforced", "not-configured"] },
        "policyPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "outOfScopePaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "commandSelection": {
      "type": "object",
      "required": ["plannedCount", "selectedCount", "executedCount", "supersededCommandIds", "notRunCommandIds"],
      "properties": {
        "plannedCount": { "type": "integer", "minimum": 0 },
        "selectedCount": { "type": "integer", "minimum": 0 },
        "executedCount": { "type": "integer", "minimum": 0 },
        "supersededCommandIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "notRunCommandIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "commandResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceId", "kind", "argv", "result", "exitCode"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "result": { "enum": ["pass", "fail"] },
          "exitCode": { "type": "integer" },
          "evaluation": { "enum": ["baseline-aware-typecheck", "command-preflight"] },
          "signal": { "type": "string" },
          "stdoutTail": { "type": "string" },
          "stderrTail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "typecheckSummary": {
      "type": "object",
      "required": ["ok", "baselineErrors", "currentErrors", "changedPathErrors", "newErrors", "baselineSource", "diagnostics", "reason"],
      "properties": {
        "ok": { "type": "boolean" },
        "baselineErrors": { "type": ["integer", "null"], "minimum": 0 },
        "currentErrors": { "type": "integer", "minimum": 0 },
        "changedPathErrors": { "type": "integer", "minimum": 0 },
        "newErrors": { "type": ["integer", "null"], "minimum": 0 },
        "baselineSource": { "enum": ["previous-dev-check", "initialized-current-outside-changed", "unavailable"] },
        "diagnostics": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["file", "line", "column", "code", "message"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 1 },
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "blockers": { "type": "array" },
    "problems": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
