{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vnext-exit-result.schema.json",
  "title": "docs_tdd vNext Final Exit Result",
  "type": "object",
  "required": ["schemaVersion", "workflowVersion", "tool", "mode", "assuranceMode", "evidenceTrust", "runId", "generatedAt", "projectId", "level", "status", "ok", "workItemFingerprint", "codeFingerprint", "checks", "summary", "blockedBy", "resultFingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workflowVersion": { "const": 2 },
    "tool": { "const": "vnext-verify.mjs" },
    "mode": { "type": "string", "enum": ["enforced", "shadow"] },
    "assuranceMode": { "type": "string", "enum": ["assisted-pilot", "autonomous"] },
    "evidenceTrust": { "type": "string", "enum": ["caller-supplied", "cli-attested"] },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "projectId": { "type": "string", "pattern": "^(?:PR|TR)-\\d{5}$" },
    "level": { "type": "string", "enum": ["V0", "V1", "V2"] },
    "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
    "ok": { "type": "boolean" },
    "workItemFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "codeFingerprint": {
      "type": "object",
      "required": ["headSha", "baseSha", "contentHash", "dirtyHash", "dirtyFileCount", "untrackedFileCount", "isGitRepo"],
      "properties": {
        "headSha": { "type": "string" },
        "baseSha": { "type": "string" },
        "contentHash": { "type": "string" },
        "dirtyHash": { "type": "string" },
        "dirtyFileCount": { "type": "integer", "minimum": 0 },
        "untrackedFileCount": { "type": "integer", "minimum": 0 },
        "isGitRepo": { "type": "boolean" },
        "scopeMode": { "const": "path-set-v1" },
        "scopePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "scopeMode": { "const": "path-set-v1" } }, "required": ["scopeMode"] },
          "then": { "required": ["scopePaths"] }
        }
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "ok", "problems"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "ok": { "type": "boolean" },
          "problems": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "blockedBy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "failureDomains": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["source", "scope", "code", "browser", "environment", "external-dependency"] }
    },
    "evidenceAttestation": {
      "type": "object",
      "required": ["issuedBy", "projectId", "workItemFingerprint", "codeContentHash", "planFingerprint", "runId", "startedAt", "completedAt", "signature", "bundleFingerprint"],
      "properties": {
        "issuedBy": { "const": "docs-tdd-evidence-v1" },
        "projectId": { "type": "string", "pattern": "^(?:PR|TR)-\\d{5}$" },
        "workItemFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "codeContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "planFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "runId": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bundleFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "resultFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "assuranceMode": { "const": "autonomous" } }, "required": ["assuranceMode"] },
      "then": { "required": ["evidenceAttestation"], "properties": { "evidenceTrust": { "const": "cli-attested" } } }
    },
    {
      "if": { "properties": { "assuranceMode": { "const": "assisted-pilot" } }, "required": ["assuranceMode"] },
      "then": { "properties": { "evidenceTrust": { "const": "caller-supplied" } } }
    }
  ],
  "additionalProperties": false
}
