{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vnext-exit-result.schema.json",
  "title": "docs_tdd vNext Final Exit Result",
  "type": "object",
  "required": ["schemaVersion", "workflowVersion", "tool", "mode", "runId", "generatedAt", "projectId", "level", "status", "ok", "workItemFingerprint", "codeFingerprint", "checks", "summary", "blockedBy", "resultFingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workflowVersion": { "const": 2 },
    "tool": { "const": "vnext-verify.mjs" },
    "mode": { "type": "string", "enum": ["enforced", "shadow"] },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "projectId": { "type": "string", "pattern": "^PR-\\d{5}$" },
    "level": { "type": "string", "enum": ["V0", "V1", "V2"] },
    "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
    "ok": { "type": "boolean" },
    "workItemFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "codeFingerprint": {
      "type": "object",
      "required": ["headSha", "baseSha", "dirtyHash", "dirtyFileCount", "untrackedFileCount", "isGitRepo"],
      "properties": {
        "headSha": { "type": "string" },
        "baseSha": { "type": "string" },
        "dirtyHash": { "type": "string" },
        "dirtyFileCount": { "type": "integer", "minimum": 0 },
        "untrackedFileCount": { "type": "integer", "minimum": 0 },
        "isGitRepo": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "ok", "problems"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "ok": { "type": "boolean" },
          "problems": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "blockedBy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "resultFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
