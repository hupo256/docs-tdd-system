{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rule-waivers.schema.json",
  "title": "Project Rule Waivers",
  "description": "Temporary rule waivers for a project. Empty array means no waivers; to express 'no waivers needed', keep the file as [] or omit it.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["ruleId", "reason", "owner", "expiresAt"],
    "properties": {
      "ruleId": { "type": "string" },
      "file": { "type": "string" },
      "reason": { "type": "string", "minLength": 1 },
      "owner": { "type": "string", "minLength": 1 },
      "expiresAt": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "additionalProperties": false
  }
}
