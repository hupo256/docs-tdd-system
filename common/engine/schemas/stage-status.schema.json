{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stage-status.schema.json",
  "title": "docs_tdd Stage Status",
  "type": "object",
  "required": ["projectId", "stages"],
  "properties": {
    "projectId": { "type": "string", "pattern": "^(?:PR|TR)-\\d{5}$" },
    "stages": {
      "type": "object",
      "properties": {
        "G5": { "$ref": "#/definitions/g5Status" },
        "G6": { "$ref": "#/definitions/g6Status" },
        "G7": { "$ref": "#/definitions/g7Status" }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "g5Status": {
      "type": "object",
      "required": ["status", "reason", "evidence", "updatedAt"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "blocked", "frontend-complete-pending-reconcile", "frontend-complete-pending-verify", "completed", "not-applicable"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "confirmedBy": { "type": "string", "minLength": 1, "description": "人工确认签名：谁确认了这个阶段处置（DOC-CONFIRM-001/002）。AI 客户端名不算人工确认。" },
        "confirmedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reconciledAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    },
    "g6Status": {
      "type": "object",
      "required": ["status", "reason", "evidence", "updatedAt"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "blocked", "partial-pass", "completed", "skipped"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "confirmedBy": { "type": "string", "minLength": 1, "description": "人工确认签名：谁确认了这个阶段处置（DOC-CONFIRM-001/002）。AI 客户端名不算人工确认。" },
        "confirmedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    },
    "g7Status": {
      "type": "object",
      "required": ["status", "reason", "evidence", "updatedAt"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "blocked", "completed", "skipped"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "confirmedBy": { "type": "string", "minLength": 1, "description": "人工确认签名：谁确认了这个阶段处置（DOC-CONFIRM-001/002）。AI 客户端名不算人工确认。" },
        "confirmedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
