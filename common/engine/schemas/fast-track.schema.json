{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fast-track.schema.json",
  "title": "Fast-track Decision Ledger",
  "type": "object",
  "required": ["projectId", "route", "confirmedBy", "confirmedAt", "items"],
  "properties": {
    "projectId": { "type": "string", "pattern": "^PR-\\d{5}$" },
    "route": { "type": "string", "enum": ["reuse-api", "pending-api"] },
    "confirmedBy": { "type": "string", "minLength": 1 },
    "confirmedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "semanticStatus",
          "impact",
          "summary",
          "source",
          "temporaryContract",
          "safeFallback",
          "owner",
          "reconcileWith",
          "resolveByGate",
          "status",
          "resolution",
          "evidence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^FTD-\\d{3,}$" },
          "category": {
            "type": "string",
            "enum": ["field", "visual", "permission", "amount-precision", "state-machine", "routing", "core-interaction", "other"]
          },
          "semanticStatus": { "type": "string", "enum": ["confirmed", "provisional", "undecided"] },
          "impact": { "type": "string", "enum": ["local", "cross-cutting", "irreversible"] },
          "summary": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "temporaryContract": { "type": "string" },
          "safeFallback": { "type": "string" },
          "owner": { "type": "string", "minLength": 1 },
          "reconcileWith": { "type": "string", "enum": ["api", "decision"] },
          "resolveByGate": { "type": "string", "enum": ["G5", "G6", "G8"] },
          "status": { "type": "string", "enum": ["open", "resolved"] },
          "resolution": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
