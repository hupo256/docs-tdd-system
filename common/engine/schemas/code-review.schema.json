{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "code-review.schema.json",
  "title": "docs_tdd G6 Code Review Report",
  "description": "G6 /code-review findings 的机器可读单一源。缺失文件时 G6 回退散文校验（VERIFY-G6-002）。语义见 rule-ids-and-gates.md §3.7。",
  "type": "object",
  "required": ["projectId", "reviewedAt", "reviewer", "head", "findings"],
  "properties": {
    "projectId": { "type": "string", "pattern": "^PR-\\d{5}$" },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "reviewer": { "type": "string", "minLength": 1 },
    "base": { "type": "string" },
    "head": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "summary", "disposition"],
        "properties": {
          "id": { "type": "string", "pattern": "^CR-\\d+$" },
          "category": { "type": "string", "enum": ["correctness", "reuse", "simplification", "efficiency", "security", "test-coverage", "type-safety", "other"] },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 0 },
          "summary": { "type": "string", "minLength": 1 },
          "disposition": { "type": "string", "enum": ["fixed", "waived", "not-applicable", "open"] },
          "resolution": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "disposition": { "enum": ["fixed", "waived"] } } },
            "then": { "required": ["resolution"], "properties": { "resolution": { "minLength": 1 } } }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
