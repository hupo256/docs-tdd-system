{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "assumptions.schema.json",
  "title": "Project Assumption Ledger",
  "type": "object",
  "required": ["projectId", "assumptions"],
  "properties": {
    "projectId": { "type": "string", "pattern": "^(?:PR|TR)-\\d{5}$" },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "endpoint", "field", "code", "owner", "status", "blockingWhen", "resolution"],
        "properties": {
          "id": { "type": "string", "pattern": "^ASM-\\d{3,}$" },
          "endpoint": { "type": "string", "minLength": 1 },
          "field": { "type": "string", "minLength": 1 },
          "code": { "type": "array", "items": { "type": "string" } },
          "owner": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["open", "confirmed", "rejected", "resolved"] },
          "resolvedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "G5 reconcile: date the assumption was settled (status=resolved)" },
          "blockingWhen": { "type": "string", "enum": ["api-ready", "reconciling", "release", "prd-clarify"] },
          "resolution": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
