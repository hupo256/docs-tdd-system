{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "blockers.schema.json",
  "title": "docs_tdd Blockers & Changes",
  "description": "跨阶段的阻塞与需求变更登记（机器可读单一源）。缺失文件即合法（零回填）。语义见 common/rules/blocking-and-change-protocol.md。",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "type", "gate", "category", "summary", "owner", "raisedAt", "status"],
    "properties": {
      "id": { "type": "string", "pattern": "^(?:BLK|CHG)-\\d+$" },
      "type": { "type": "string", "enum": ["blocker", "change"] },
      "gate": { "type": "string", "pattern": "^G[0-8]$" },
      "blocksGate": { "type": "string", "pattern": "^G[0-8]$" },
      "category": { "type": "string", "enum": ["backend", "design", "product", "env", "qa", "dependency", "other"] },
      "summary": { "type": "string", "minLength": 1 },
      "owner": { "type": "string", "minLength": 1 },
      "raisedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "status": { "type": "string", "enum": ["open", "resolved"] },
      "resolution": { "type": "string" },
      "resolvedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    },
    "additionalProperties": false,
    "allOf": [
      {
        "if": { "properties": { "status": { "const": "resolved" } } },
        "then": { "required": ["resolution", "resolvedAt"], "properties": { "resolution": { "minLength": 1 } } }
      },
      {
        "if": { "properties": { "status": { "const": "open" }, "type": { "const": "blocker" } } },
        "then": { "required": ["blocksGate"] }
      }
    ]
  }
}
