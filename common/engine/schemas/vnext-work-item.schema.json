{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vnext-work-item.schema.json",
  "title": "docs_tdd vNext Work Item",
  "type": "object",
  "required": ["schemaVersion", "workflowVersion", "projectId", "sourceSnapshot", "requirements", "coverageAudit", "routing", "apiDependency"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workflowVersion": { "const": 2 },
    "projectId": { "type": "string", "pattern": "^(?:PR|TR)-\\d{5}$" },
    "intake": {
      "type": "object",
      "required": ["kind", "sourceRole", "sourceFingerprint", "sourcePaths"],
      "properties": {
        "kind": { "enum": ["feature", "bugfix"] },
        "sourceRole": { "enum": ["prd", "incident"] },
        "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "bugfix" } }, "required": ["kind"] },
          "then": { "properties": { "sourceRole": { "const": "incident" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "feature" } }, "required": ["kind"] },
          "then": { "properties": { "sourceRole": { "const": "prd" } } }
        }
      ]
    },
    "deliveryScope": {
      "type": ["object", "null"],
      "required": ["kind", "batchId", "includedRequirementIds", "deferred"],
      "properties": {
        "kind": { "const": "bounded-batch" },
        "batchId": { "type": "string", "minLength": 1 },
        "includedRequirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^R-\\d{3}$" }
        },
        "policyPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?!/)(?!\\.\\.(?:/|$)).+" }
        },
        "deferred": {
          "description": "Deferred remainder metadata, or null when this bounded batch has no remainder.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["owner", "batch", "reason"],
              "properties": {
                "owner": { "type": "string", "minLength": 1 },
                "batch": { "type": "string", "minLength": 1 },
                "reason": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "deliveryTarget": {
      "type": "object",
      "required": ["app", "history"],
      "properties": {
        "app": { "type": "string", "pattern": "^(?:apps|packages)/[^/]+$" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["app", "reason"],
            "properties": {
              "app": { "type": "string", "pattern": "^(?:apps|packages)/[^/]+$" },
              "invalidatedAt": { "type": "string", "format": "date-time" },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sourceSnapshot": {
      "type": "object",
      "required": ["revision", "contentHash", "sources"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "contentHash"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "contentHash": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sourceId", "path", "assetHash", "assetStatus", "mediaType"],
            "properties": {
              "sourceId": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "assetHash": { "type": "string", "pattern": "^$|^[a-f0-9]{64}$" },
              "assetStatus": { "type": "string", "enum": ["local", "embedded", "remote", "missing", "unread", "embedded-unread", "outside-root"] },
              "mediaType": { "type": "string", "pattern": "^image/" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "extractionFacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["factId", "category", "statement", "sourceIds", "requirementIds"],
        "properties": {
          "factId": { "type": "string", "pattern": "^F-\\d{3}$" },
          "category": { "enum": ["action", "content", "state", "constraint", "dependency", "permission", "navigation", "error", "collection", "entry", "visual"] },
          "statement": { "type": "string", "minLength": 1 },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^R-\\d{3}$" }
          }
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirementId", "sourceAnchors", "statement", "status", "affectedSurfaces", "evidencePlan"],
        "properties": {
          "requirementId": { "type": "string", "pattern": "^R-\\d{3}$" },
          "sourceAnchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "sourceId"],
              "properties": {
                "type": { "type": "string", "enum": ["text", "table", "image", "embed"] },
                "sourceId": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "lineStart": { "type": "integer", "minimum": 1 },
                "lineEnd": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["doing", "not-doing", "deferred"] },
          "collectionSemantics": {
            "type": "object",
            "required": ["kind", "expectedCount"],
            "properties": {
              "kind": { "type": "string", "enum": ["none", "explicit-set", "discovered-set"] },
              "expectedCount": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "affectedSurfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["surfaceId", "disposition"],
              "properties": {
                "surfaceId": { "type": "string", "pattern": "^S-\\d{3}$" },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Legacy display-only locator. Structured code proof requires codeLocator."
                },
                "displayHint": { "type": "string", "minLength": 1 },
                "codeLocator": {
                  "type": "object",
                  "required": ["kind", "app", "symbol", "role"],
                  "properties": {
                    "kind": { "enum": ["component", "hook", "function", "export", "route", "style-token", "copy-key", "api-call", "test", "browser-scenario"] },
                    "app": { "type": "string", "pattern": "^(?:apps|packages)/[^/]+$" },
                    "symbol": { "type": "string", "minLength": 1 },
                    "expectPath": { "type": "string", "minLength": 1 },
                    "role": { "enum": ["provider", "consumer", "standalone"] }
                  },
                  "additionalProperties": false
                },
                "wiring": {
                  "type": "object",
                  "required": ["role", "dependsOn", "wiringEvidence"],
                  "properties": {
                    "role": { "enum": ["provider", "consumer", "standalone"] },
                    "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^S-\\d{3}$" } },
                    "wiringEvidence": { "enum": ["import", "render", "event-binding", "browser"] }
                  },
                  "additionalProperties": false
                },
                "blockedBy": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "disposition": { "type": "string", "enum": ["implement", "already-covered", "not-applicable", "deferred"] },
                "reason": { "type": "string" },
                "owner": { "type": "string" },
                "batch": { "type": "string" }
              },
              "anyOf": [
                { "required": ["locator"] },
                { "required": ["codeLocator"] }
              ],
              "allOf": [
                {
                  "if": { "properties": { "codeLocator": { "properties": { "role": { "const": "consumer" } }, "required": ["role"] } }, "required": ["codeLocator"] },
                  "then": { "required": ["wiring"], "properties": { "wiring": { "properties": { "role": { "const": "consumer" }, "dependsOn": { "minItems": 1 } } } } }
                }
              ],
              "additionalProperties": false
            }
          },
          "evidencePlan": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "runtimeRequired"],
              "properties": {
                "type": { "type": "string", "enum": ["copy-literal", "component-dom", "pure-logic", "payload-contract", "api-contract", "browser-interaction", "human-check", "structural", "quality", "touched-file-quality", "visual"] },
                "runtimeRequired": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "extractionAudit": {
      "type": "object",
      "required": ["schemaVersion", "auditedAt", "sourceFingerprint", "requirementsFingerprint", "sourceUnitsFingerprint", "status", "checks"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "auditedAt": { "type": "string", "format": "date-time" },
        "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requirementsFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidencePlanFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceUnitsFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "microEligibility": {
          "type": "object",
          "required": ["ok", "mode", "sourceFingerprint", "requirementsFingerprint", "evidencePlanFingerprint", "sourceUnitsFingerprint", "problems"],
          "properties": {
            "ok": { "type": "boolean" },
            "mode": { "const": "deterministic-micro-audit" },
            "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "requirementsFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "evidencePlanFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "sourceUnitsFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "problems": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        },
        "status": { "enum": ["pass", "fail"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "ok", "problems"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "ok": { "type": "boolean" },
              "problems": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "reviewControl": {
      "type": "object",
      "required": ["sourceFingerprint", "attempts", "status"],
      "properties": {
        "sourceFingerprint": { "type": "string", "minLength": 1 },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
        "maxAttempts": { "enum": [2, 3], "description": "New review cycles use 2; 3 is accepted only for persisted legacy history." },
        "transportFailures": { "type": "integer", "minimum": 0 },
        "requiresPretestHumanRun": { "type": "boolean" },
        "status": { "enum": ["active", "changes-required", "passed", "adjudicated", "human-review-deferred", "escalated"] },
        "reason": { "enum": ["reviewer-unavailable", "repeated-findings", "review-attempt-limit"] },
        "escalatedAt": { "type": "string", "format": "date-time" },
        "deferredAt": { "type": "string", "format": "date-time" },
        "lastError": { "type": "string" },
        "history": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["reviewRunId", "completedAt", "requirementsFingerprint", "verdict", "findingSignature", "findings"],
            "properties": {
              "reviewRunId": { "type": "string", "minLength": 1 },
              "completedAt": { "type": "string", "format": "date-time" },
              "requirementsFingerprint": { "type": "string", "minLength": 1 },
              "verdict": { "enum": ["pass", "changes-required"] },
              "findingSignature": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["findingId", "code", "message", "sourceIds", "disposition"],
                  "properties": {
                    "findingId": { "type": "string", "minLength": 1 },
                    "code": { "type": "string", "minLength": 1 },
                    "message": { "type": "string", "minLength": 1 },
                    "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                    "disposition": { "type": "string", "minLength": 1 },
                    "reason": { "type": "string" },
                    "owner": { "type": "string" },
                    "batch": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "candidateRequirements": {
                "description": "Legacy full candidate snapshot. New writers persist candidateRequirementFingerprints instead.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["requirementId"],
                  "properties": { "requirementId": { "type": "string", "pattern": "^R-\\d{3}$" } },
                  "additionalProperties": true
                }
              },
              "candidateRequirementFingerprints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["requirementId", "fingerprint"],
                  "properties": {
                    "requirementId": { "type": "string", "pattern": "^R-\\d{3}$" },
                    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "coverageAudit": {
      "type": "object",
      "required": ["sourceFingerprint", "requirementsFingerprint", "reviewMode", "reviewRunId", "reviewer", "completedAt", "verdict", "unresolved"],
      "properties": {
        "sourceFingerprint": { "type": "string", "minLength": 1 },
        "requirementsFingerprint": { "type": "string", "minLength": 1 },
        "evidencePlanFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviewMode": { "const": "independent-cold-read" },
        "reviewRunId": { "type": "string", "minLength": 1 },
        "reviewer": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "type": "string", "enum": ["human", "model"] },
            "id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "completedAt": { "type": "string", "format": "date-time" },
        "verdict": { "type": "string", "enum": ["pass", "changes-required"] },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["findingId", "code", "message", "sourceIds", "disposition"],
            "properties": {
              "findingId": { "type": "string", "minLength": 1 },
              "code": { "type": "string", "enum": ["missing-requirement", "merged-requirement", "ambiguous-collection", "missing-surface", "inadequate-evidence-command", "other"] },
              "message": { "type": "string", "minLength": 1 },
              "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "disposition": { "type": "string", "enum": ["resolved", "not-applicable", "deferred", "open"] },
              "reason": { "type": "string" },
              "owner": { "type": "string" },
              "batch": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "receipt": {
          "type": "object",
          "required": ["issuedBy", "client", "sessionId", "sourceIsolation", "requestFingerprint", "reviewedAssets", "startedAt", "completedAt", "signature"],
          "properties": {
            "issuedBy": { "const": "docs-tdd-review-v1" },
            "client": { "type": "string", "enum": ["pi", "claude", "codex"] },
            "sessionId": { "type": "string", "minLength": 1 },
            "sourceIsolation": { "const": "source-only-no-code" },
            "requestFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "reviewedAssets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["sourceId", "assetHash"],
                "properties": {
                  "sourceId": { "type": "string", "minLength": 1 },
                  "assetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                },
                "additionalProperties": false
              }
            },
            "startedAt": { "type": "string", "format": "date-time" },
            "completedAt": { "type": "string", "format": "date-time" },
            "signature": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "unresolved": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": ["scopeClass", "riskSignals", "verificationLevel", "routerVersion"],
      "properties": {
        "scopeClass": { "type": "string", "enum": ["local", "multi-surface", "cross-boundary"] },
        "riskSignals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["unclassified", "password", "authentication-surface", "multiple-entry-points", "shared-component", "contract-change", "funds", "trading", "permission", "irreversible", "new-api", "cross-app", "fee-semantics", "amount-semantics"]
          }
        },
        "verificationLevel": { "type": "string", "enum": ["V0", "V1", "V2"] },
        "routerVersion": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "apiDependency": {
      "type": "object",
      "required": ["mode", "reason"],
      "properties": {
        "mode": { "type": "string", "enum": ["no-request", "real-api", "mock-required", "pending-dependency"] },
        "reason": { "type": "string", "minLength": 1 },
        "contractIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "blockerId": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "ready"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "ready": { "type": "boolean" },
              "reason": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "mock-required" } }, "required": ["mode"] },
          "then": { "required": ["contractIds"], "properties": { "contractIds": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "mode": { "const": "pending-dependency" } }, "required": ["mode"] },
          "then": { "required": ["blockerId"] }
        }
      ],
      "additionalProperties": false
    },
    "sourceReadiness": {
      "type": ["object", "null"],
      "required": ["figma", "api"],
      "properties": {
        "figma": { "$ref": "#/definitions/lateSource" },
        "api": { "$ref": "#/definitions/lateSource" }
      },
      "additionalProperties": false
    },
    "evidenceCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidenceId", "kind", "argv"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "requirementIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^R-\\d{3}$" } },
          "surfaceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^S-\\d{3}$" } },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 1800 }
        },
        "additionalProperties": false
      }
    },
    "sourceUnitDispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "disposition"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "disposition": { "type": "string", "enum": ["anchored", "not-a-requirement"] },
          "reason": { "type": "string", "minLength": 1 },
          "exclusionEvidence": {
            "type": "object",
            "required": ["basis", "sourceQuote"],
            "properties": {
              "basis": { "type": "string", "enum": ["explicit-out-of-scope", "example-only", "context-only"] },
              "sourceQuote": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "disposition": { "const": "not-a-requirement" } } },
            "then": { "required": ["reason", "exclusionEvidence"] }
          }
        ]
      }
    },
    "requirementsAuthor": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["human", "model"] },
        "id": { "type": "string", "minLength": 1 },
        "client": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "model" } }, "required": ["kind"] },
          "then": { "required": ["client", "sessionId"] }
        }
      ]
    },
    "scopeApproval": {
      "type": ["object", "null"],
      "required": ["confirmationKind", "confirmedBy", "confirmedAt", "reason", "recordedVia", "fingerprint"],
      "properties": {
        "confirmationKind": { "const": "human" },
        "confirmedBy": { "type": "string", "minLength": 1 },
        "confirmedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reason": { "type": "string", "minLength": 1 },
        "recordedVia": {
          "type": "object",
          "required": ["client"],
          "properties": {
            "client": { "type": "string", "minLength": 1 },
            "sessionId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "fingerprint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reviewAdjudication": {
      "type": ["object", "null"],
      "required": ["schemaVersion", "originalReviewRunId", "sourceFingerprint", "requirementsFingerprint", "adjudicatedBy", "adjudicatedAt", "reason", "recordedVia", "decisions", "effectiveVerdict"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "originalReviewRunId": { "type": "string", "minLength": 1 },
        "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requirementsFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "baseRequirementsFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "repairConfirmation": { "const": true },
        "adjudicatedBy": { "type": "string", "minLength": 1 },
        "adjudicatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reason": { "type": "string", "minLength": 1 },
        "recordedVia": { "$ref": "#/definitions/recordedVia" },
        "effectiveVerdict": { "enum": ["pass", "changes-required"] },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["findingId", "disposition", "reason"],
            "properties": {
              "findingId": { "type": "string", "minLength": 1 },
              "disposition": { "enum": ["accepted", "resolved", "rejected", "not-applicable", "deferred"] },
              "reason": { "type": "string", "minLength": 1 },
              "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "owner": { "type": "string", "minLength": 1 },
              "batch": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "resumedBy": { "type": "string", "minLength": 1 },
        "resumedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "resumeReason": { "type": "string", "minLength": 1 },
        "resumeRecordedVia": { "$ref": "#/definitions/recordedVia" }
      },
      "additionalProperties": false
    },
    "manualTestRun": {
      "type": "object",
      "required": ["schemaVersion", "runId", "sourceFingerprint", "requirementsFingerprint", "codeFingerprint", "environment", "confirmedBy", "confirmedAt", "status"],
      "properties": {
        "schemaVersion": { "enum": [1, 2] },
        "runId": { "type": "string", "minLength": 1 },
        "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requirementsFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "codeFingerprint": { "type": "object" },
        "environment": {
          "type": "object",
          "required": ["worktree", "baseRef", "headSha"],
          "properties": {
            "worktree": { "type": "string", "minLength": 1 },
            "baseRef": { "type": "string", "minLength": 1 },
            "headSha": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "confirmedBy": { "type": "string", "minLength": 1 },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["passed", "failed", "blocked"] },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["requirementId", "surfaceIds", "result", "actualResult"],
            "properties": {
              "requirementId": { "type": "string", "pattern": "^R-\\d{3}$" },
              "surfaceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^S-\\d{3}$" } },
              "result": { "enum": ["passed", "failed", "not-testable"] },
              "actualResult": { "type": "string" },
              "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "blocker": { "type": "string", "minLength": 1 },
              "newOmissions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false,
            "allOf": [{ "if": { "properties": { "result": { "const": "not-testable" } }, "required": ["result"] }, "then": { "required": ["blocker"] } }]
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scenarioId", "kind", "title", "steps", "expected", "requirementIds", "surfaceIds", "result", "actual", "unresolved", "newOmissions"],
            "properties": {
              "scenarioId": { "type": "string", "pattern": "^MT-\\d{3}$" },
              "kind": { "enum": ["functional", "visual"] },
              "title": { "type": "string", "minLength": 1 },
              "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "expected": { "type": "string", "minLength": 1 },
              "requirementIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^R-\\d{3}$" } },
              "surfaceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^S-\\d{3}$" } },
              "result": { "enum": ["passed", "failed", "not-testable"] },
              "actual": { "type": "string" },
              "unresolved": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "blocker": { "type": "string", "minLength": 1 },
              "newOmissions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false,
            "allOf": [
              { "if": { "properties": { "result": { "const": "not-testable" } }, "required": ["result"] }, "then": { "required": ["blocker"] } },
              {
                "if": { "properties": { "result": { "enum": ["passed", "failed"] } }, "required": ["result"] },
                "then": { "properties": { "actual": { "minLength": 1 } } }
              },
              {
                "if": { "properties": { "result": { "const": "passed" } }, "required": ["result"] },
                "then": { "properties": { "unresolved": { "maxItems": 0 } } }
              }
            ]
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "schemaVersion": { "const": 1 } }, "required": ["schemaVersion"] }, "then": { "required": ["results"] } },
        { "if": { "properties": { "schemaVersion": { "const": 2 } }, "required": ["schemaVersion"] }, "then": { "required": ["scenarios"] } }
      ],
      "additionalProperties": false
    },
    "autopilot": {
      "type": "object",
      "required": ["phase", "implementation", "lastCheckpointAt"],
      "properties": {
        "phase": {
          "enum": ["intake", "planning", "implementing", "implementation-ready", "validating", "ready-to-test", "delivered", "blocked"]
        },
        "implementation": {
          "type": "object",
          "required": ["status", "changedPaths"],
          "properties": {
            "status": { "enum": ["pending", "in-progress", "completed"] },
            "checkpoint": {
              "type": "object",
              "required": ["actionId", "outcome", "recordedAt"],
              "properties": {
                "actionId": { "type": "string", "minLength": 1 },
                "outcome": { "enum": ["in-progress", "completed", "blocked"] },
                "recordedAt": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            },
            "changedPaths": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "discoveredSurfaces": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["surfaceId", "locator"],
                "properties": {
                  "surfaceId": { "type": "string", "minLength": 1 },
                  "locator": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "coveredSurfaceIds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "msw": {
              "type": "object",
              "required": ["workerIntegrated", "handlerIds", "coveredContractIds"],
              "properties": {
                "workerIntegrated": { "type": "boolean" },
                "handlerIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                "coveredContractIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
              },
              "additionalProperties": false
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["blockerId", "status", "reason"],
                "properties": {
                  "blockerId": { "type": "string", "minLength": 1 },
                  "status": { "enum": ["open", "resolved"] },
                  "reason": { "type": "string", "minLength": 1 },
                  "owner": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "completedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "checkpointCommit": {
          "type": "object",
          "required": ["status", "commitSha", "paths", "committedAt", "pushed", "nonDelivery"],
          "properties": {
            "status": { "const": "committed" },
            "commitSha": { "type": "string", "minLength": 1 },
            "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "committedAt": { "type": "string", "format": "date-time" },
            "pushed": { "const": false },
            "nonDelivery": { "const": true }
          },
          "additionalProperties": false
        },
        "delivery": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["pending", "committed"] },
            "commitSha": { "type": "string", "minLength": 1 },
            "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "committedAt": { "type": "string", "format": "date-time" },
            "pushed": { "const": false }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "committed" } } },
              "then": { "required": ["commitSha", "paths", "committedAt", "pushed"] }
            }
          ],
          "additionalProperties": false
        },
        "repairAttempts": {
          "description": "Legacy code/browser mirror retained for existing workflowVersion 2 artifacts. New writers use repair.",
          "type": "object",
          "required": ["code", "browser"],
          "properties": {
            "code": { "type": "integer", "minimum": 0 },
            "browser": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "repair": {
          "type": "object",
          "required": ["attempts", "lastFailure", "terminalState"],
          "properties": {
            "attempts": {
              "type": "object",
              "required": ["source", "scope", "code", "browser", "environment", "external-dependency"],
              "properties": {
                "source": { "type": "integer", "minimum": 0 },
                "scope": { "type": "integer", "minimum": 0 },
                "code": { "type": "integer", "minimum": 0 },
                "browser": { "type": "integer", "minimum": 0 },
                "environment": { "type": "integer", "minimum": 0 },
                "external-dependency": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            },
            "lastFailure": {
              "type": ["object", "null"],
              "required": ["domains", "inputFingerprint", "failureFingerprint", "recordedAt"],
              "properties": {
                "domains": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "enum": ["source", "scope", "code", "browser", "environment", "external-dependency"] }
                },
                "inputFingerprint": { "type": "string", "minLength": 1 },
                "failureFingerprint": { "type": "string", "minLength": 1 },
                "recordedAt": { "type": "string", "format": "date-time" }
              },
              "additionalProperties": false
            },
            "terminalState": {
              "type": ["string", "null"],
              "enum": [null, "blocked-user-decision", "escalate-repair-failure", "failed-infrastructure", "blocked-external-dependency"]
            }
          },
          "additionalProperties": false
        },
        "lastCheckpointAt": { "type": "string", "format": "date-time" },
        "lastDevCheck": {
          "type": "object",
          "required": ["schemaVersion", "projectId", "runId", "checkedAt", "status", "ok", "codeState", "pendingCommitPaths", "unmappedPaths", "problems"],
          "properties": {
            "schemaVersion": { "const": 1 },
            "projectId": { "type": "string", "pattern": "^(?:PR|TR)-\\d{5}$" },
            "runId": { "type": "string", "minLength": 1 },
            "checkedAt": { "type": "string", "format": "date-time" },
            "status": { "enum": ["passed", "failed", "blocked"] },
            "ok": { "type": "boolean" },
            "codeState": {
              "type": "object",
              "required": ["headSha", "contentHash", "dirtyHash"],
              "properties": {
                "headSha": { "type": "string", "minLength": 1 },
                "contentHash": { "type": "string", "minLength": 1 },
                "dirtyHash": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "pendingCommitPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "unmappedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "problems": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "changedPaths": {
              "description": "Legacy inline dev-check detail. New writers persist it in latest-dev-check.json.",
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "pathCoverage": {
              "description": "Legacy inline dev-check detail. New writers persist it in latest-dev-check.json.",
              "type": "array"
            },
            "pathPolicy": {
              "description": "Legacy inline dev-check detail. New writers persist it in latest-dev-check.json.",
              "type": "object"
            },
            "commandSelection": {
              "description": "Legacy inline dev-check detail. New writers persist it in latest-dev-check.json.",
              "type": "object"
            },
            "commandResults": {
              "description": "Legacy inline dev-check detail. New writers persist it in latest-dev-check.json.",
              "type": "array"
            },
            "typecheckSummary": {
              "description": "Legacy inline dev-check detail. New writers persist it in latest-dev-check.json.",
              "type": "object"
            },
            "blockers": {
              "description": "Legacy inline dev-check detail. New writers persist it in latest-dev-check.json.",
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "anyOf": [
        { "required": ["repair"] },
        { "required": ["repairAttempts"] }
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requirements": { "type": "array", "minItems": 1 }
        },
        "required": ["requirements"]
      },
      "then": { "required": ["requirementsAuthor"] }
    }
  ],
  "definitions": {
    "recordedVia": {
      "type": "object",
      "required": ["client"],
      "properties": {
        "client": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "lateSource": {
      "type": "object",
      "required": ["requirement", "status", "reason"],
      "properties": {
        "requirement": { "enum": ["unknown", "required", "not-required"] },
        "status": { "enum": ["pending", "available", "integrated", "not-required"] },
        "reason": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "source": {
          "type": "object",
          "required": ["path", "revision", "fingerprint"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 },
            "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "integratedFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "integratedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
