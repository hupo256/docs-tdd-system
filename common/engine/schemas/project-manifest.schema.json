{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project-manifest.schema.json",
  "title": "docs_tdd Project Manifest",
  "type": "object",
  "required": ["projectId", "createdAt", "rulesetVersion", "templateVersion", "pilot", "gatePolicy"],
  "properties": {
    "projectId": { "type": "string", "pattern": "^(?:PR|TR)-\\d{5}$" },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rulesetVersion": { "type": "string", "minLength": 1 },
    "templateVersion": { "type": "integer", "minimum": 1 },
    "pilot": {
      "type": "object",
      "required": ["msw"],
      "properties": {
        "msw": { "type": "boolean" },
        "prdIntake": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "gatePolicy": {
      "type": "object",
      "required": ["legacyRules", "currentTouchedRules"],
      "properties": {
        "legacyRules": { "type": "string", "enum": ["report-only", "blocking"] },
        "currentTouchedRules": { "type": "string", "enum": ["report-only", "blocking"] }
      },
      "additionalProperties": false
    },
    "rulePolicy": {
      "type": "object",
      "description": "Per-project rule version pin (Phase 2 decoupling). Written by lib/rule-pin.mjs (lazy pin / explicit upgrade) and lib/project-scaffold.mjs (new project). policyFingerprint is the identity a G6 session validates against — a docs_tdd release bump does not retroactively invalidate a pinned project. commit is null when no docs_tdd commit is resolvable.",
      "required": ["commit", "policyFingerprint", "upgradeMode", "pinnedAt"],
      "properties": {
        "commit": { "type": ["string", "null"] },
        "policyFingerprint": { "type": "string", "minLength": 1 },
        "upgradeMode": { "type": "string", "enum": ["explicit"] },
        "pinnedAt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
