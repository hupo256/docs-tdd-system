{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project-frontmatter.schema.json",
  "title": "Project README Frontmatter",
  "description": "Machine-readable metadata at the top of each PR-xxxxx or TR-xxxxx README.md",
  "type": "object",
  "required": ["projectId", "status", "stage", "branch", "worktree", "port", "visualFidelity", "prdSource", "figmaNode", "larkEnabled"],
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^(?:(?:PR|TR)-\\d{5,}|(?:PR|TR)-[A-Za-z][A-Za-z0-9]*)$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "closed", "archived"]
    },
    "stage": {
      "type": "string",
      "pattern": "^G[0-8]$"
    },
    "branch": {
      "type": "string"
    },
    "worktree": {
      "type": "string"
    },
    "port": {
      "type": "string"
    },
    "visualFidelity": {
      "type": "string",
      "enum": ["standard", "high"]
    },
    "prdSource": {
      "type": "string"
    },
    "figmaNode": {
      "type": "string"
    },
    "larkEnabled": {
      "type": "boolean"
    },
    "workItemKind": {
      "type": "string",
      "enum": ["feature", "bugfix"]
    },
    "workflowVersion": {
      "type": "integer",
      "enum": [1, 2]
    },
    "indexGroup": {
      "type": "string",
      "enum": ["active", "closed", "fixture"]
    }
  },
  "additionalProperties": false
}
