{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vnext-pilot-registry.schema.json",
  "title": "docs_tdd vNext Pilot Registry",
  "type": "object",
  "required": ["schemaVersion", "mode", "minimumSamples", "maximumSamples", "requiredLevels", "qualificationTarget", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "explicit-dual-track-shadow" },
    "minimumSamples": { "type": "integer", "minimum": 3, "maximum": 10 },
    "maximumSamples": { "type": "integer", "minimum": 3, "maximum": 10 },
    "requiredLevels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["V0", "V1", "V2"] }
    },
    "qualificationTarget": {
      "type": "object",
      "required": ["readinessCaseId", "release", "publicCommandsOnly"],
      "additionalProperties": false,
      "properties": {
        "readinessCaseId": { "const": "R-13" },
        "release": { "type": "string", "minLength": 1 },
        "publicCommandsOnly": { "const": true }
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["projectId", "artifactDir", "artifactMode", "enrolledAt", "newRequirement", "executionAttestation", "observation"],
        "properties": {
          "sampleId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$" },
          "projectId": { "type": "string", "pattern": "^(?:PR|TR)-\\d{5}$" },
          "artifactDir": { "type": "string", "minLength": 1 },
          "artifactMode": { "type": "string", "enum": ["isolated-snapshot", "project"] },
          "enrolledAt": { "type": "string", "format": "date-time" },
          "newRequirement": { "const": true },
          "executionAttestation": {
            "type": ["object", "null"],
            "required": ["release", "publicCommandsOnly", "attestedBy", "attestedAt"],
            "properties": {
              "release": { "type": "string", "minLength": 1 },
              "publicCommandsOnly": { "const": true },
              "attestedBy": { "type": "string", "minLength": 1 },
              "attestedAt": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          },
          "observation": {
            "type": ["object", "null"],
            "required": ["confirmedBy", "observedThrough", "requirementOmissionEscapes", "falseGreenEscapes"],
            "properties": {
              "confirmedBy": { "type": "string", "minLength": 1 },
              "observedThrough": { "type": "string", "format": "date-time" },
              "requirementOmissionEscapes": { "type": "integer", "minimum": 0 },
              "falseGreenEscapes": { "type": "integer", "minimum": 0 },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "candidateAssessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "sourceRef", "sourceRevision", "sourceContentHash", "requestedLevel", "classifiedLevel", "decision", "assessedAt", "reason"],
        "properties": {
          "projectId": { "type": "string", "pattern": "^(?:PR|TR)-\\d{5}$" },
          "sourceRef": { "type": "string", "minLength": 1 },
          "sourceRevision": { "type": "string", "minLength": 1 },
          "sourceContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "requestedLevel": { "enum": ["V0", "V1", "V2"] },
          "classifiedLevel": { "enum": ["V0", "V1", "V2"] },
          "decision": { "enum": ["eligible", "ineligible-for-requested-level", "needs-clarification"] },
          "assessedAt": { "type": "string", "format": "date-time" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "excludedCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["projectId", "source", "decidedAt", "decision", "reason"],
        "properties": {
          "projectId": { "type": "string", "pattern": "^(?:PR|TR)-\\d{5}$" },
          "source": { "type": "string", "minLength": 1 },
          "decidedAt": { "type": "string", "format": "date-time" },
          "decision": { "const": "not-coding-pilot" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
