{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "acceptance-results.schema.json",
  "title": "docs_tdd Acceptance Results",
  "type": "object",
  "required": ["projectId", "head", "items"],
  "properties": {
    "projectId": { "type": "string", "pattern": "^PR-\\d{5}$" },
    "head": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "featureId", "scenario", "method", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-\\d+$" },
          "featureId": { "type": "string", "pattern": "^F\\d+$" },
          "scenario": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "enum": ["vitest", "browser", "contract", "manual-visual", "manual", "not-applicable"] },
          "status": { "type": "string", "enum": ["passed", "failed", "blocked", "not-applicable"] },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "reason": { "type": "string" },
          "owner": { "type": "string" },
          "confirmedBy": { "type": "string", "minLength": 1, "description": "人工确认签名：manual/manual-visual/browser 的 passed 项须由人签（DOC-CONFIRM-003）。" },
          "confirmedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
