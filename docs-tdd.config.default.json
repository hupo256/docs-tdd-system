{
  "version": 1,
  "appSubpath": ".",
  "docsMountPath": "docs_tdd",
  "baseRef": "origin/main",
  "projectIdPattern": "PR-\\d{5}",
  "branchPrefix": "feature/",
  "defaultPort": 3000,
  "portRangeStart": 3000,
  "verifyPath": "/",
  "ruleSurfaces": {
    "agents": ["AGENTS.md"],
    "claude": ["CLAUDE.md"],
    "cursorRulesDir": ".cursor/rules"
  },
  "protectedRuleSurfaces": ["AGENTS.md", "CLAUDE.md", ".cursor", ".claude", ".husky", "package.json"],
  "ruleConflictOverrides": [],
  "ruleInjection": {
    "blockingRuleGlobs": [
      "001-guidelines.mdc",
      "definition-of-done.mdc",
      "frontend-harness.mdc"
    ],
    "advisoryRuleGlobs": [
      "advanced-*.mdc",
      "architecture-*.mdc",
      "async-*.mdc",
      "bundle-*.mdc",
      "client-*.mdc",
      "js-*.mdc",
      "patterns-*.mdc",
      "react19-*.mdc",
      "rendering-*.mdc",
      "rerender-*.mdc",
      "server-*.mdc",
      "state-*.mdc"
    ],
    "blockingBudgetBytes": 8192,
    "advisoryCatalogBudgetBytes": 4096,
    "combinedBudgetBytes": 16384,
    "deliveryModes": {
      "codex": "preflight",
      "claude": "preflight",
      "pi": "preflight"
    }
  },
  "repoEntryDuplicates": [],
  "globalAdapters": {
    "aiRules": "~/.ai-rules",
    "codex": "~/.codex",
    "claude": "~/.claude",
    "pi": "~/.pi/agent",
    "cursorLocalGovernance": "~/.cursor/rules/local-governance.mdc"
  },
  "enforcementWiring": {
    "ciConfigCandidates": [".gitlab-ci.yml", ".github/workflows"],
    "ciMarker": "verify-code-rules.mjs",
    "precommitConfig": "package.json",
    "precommitMarker": "precommit-verify-code-rules.mjs",
    "deliveryGuardMarker": "vnext-delivery-guard.mjs"
  },
  "typecheckRoots": [],
  "productionBuild": [],
  "moduleImportAliases": [],
  "larkOutputDir": "docs_tdd/prds/${projectId}/inbox/lark-sync"
}
