{
  "version": 1,
  "appSubpath": "apps/web",
  "docsMountPath": "apps/web/docs_tdd",
  "baseRef": "origin/online",
  "projectIdPattern": "PR-\\d{5}",
  "branchPrefix": "feature/",
  "defaultPort": 4101,
  "portRangeStart": 4101,
  "verifyPath": "/zh-CN",
  "ruleSurfaces": {
    "agents": ["AGENTS.md"],
    "claude": ["CLAUDE.md"],
    "cursorRulesDir": ".cursor/rules"
  },
  "protectedRuleSurfaces": ["AGENTS.md", "CLAUDE.md", ".cursor", ".claude", ".husky", "package.json"],
  "ruleConflictOverrides": [],
  "repoEntryDuplicates": [
    {
      "id": "build-commands",
      "canonicalFile": "AGENTS.md",
      "canonicalAnchor": "Build, Test, and Development Commands",
      "bannedIn": [
        { "file": "CLAUDE.md", "mustNotContain": ["turbo run dev --filter=\"@fameex/web\"", "pnpm build:dev / :pre / :prod"] }
      ]
    },
    {
      "id": "precommit-lint-discipline",
      "canonicalFile": "AGENTS.md",
      "canonicalAnchor": "Coding Style & Naming Conventions",
      "bannedIn": [
        { "file": "CLAUDE.md", "mustNotContain": ["Always run `pnpm lint` and `pnpm type-check` before committing"] }
      ]
    },
    {
      "id": "state-ownership",
      "canonicalFile": "AGENTS.md",
      "canonicalAnchor": "State & Data Guidelines",
      "bannedIn": [
        { "file": "CLAUDE.md", "mustNotContain": ["Zustand for local, React Query for server state"] }
      ]
    }
  ],
  "globalAdapters": {
    "aiRules": "~/.ai-rules",
    "codex": "~/.codex",
    "claude": "~/.claude",
    "cursorLocalGovernance": "~/.cursor/rules/fameex-local-governance.mdc"
  },
  "typecheckRoots": ["apps/web", "apps/admin"],
  "productionBuild": ["pnpm", "--filter", "@fameex/web", "build"],
  "moduleImportAliases": ["@fameex/ui"],
  "larkOutputDir": "apps/web/docs_tdd/prds/${projectId}/inbox/lark-sync"
}
